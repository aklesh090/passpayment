# ──────────────────────────────────────────────
# Rangilo Raas 2.0 — Client Environment Variables
# Copy this file to .env.local and fill in values
# ──────────────────────────────────────────────

# NOTE: The Razorpay KEY_ID is now served from the backend per-order response.
# You do NOT need to set VITE_RAZORPAY_KEY_ID — the server sends it securely.
# (Checkout.jsx uses razorpayKeyId from the API response, not an env var)

# API base URL — only needed if NOT using the Vite proxy (i.e., separate deployments)
# When running dev server, the Vite proxy in vite.config.js handles /api → localhost:5000
# VITE_API_URL=https://your-backend.example.com
