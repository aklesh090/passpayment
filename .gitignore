# ──────────────────────────────────────────────
# Rangilo Raas 2.0 — .gitignore
# ──────────────────────────────────────────────

# Dependencies
node_modules/

# Environment — NEVER commit any .env file
.env
.env.*
*.env
!.env.example

# Credentials & Keys
*.pem
*.key
*.cert
credentials.json

# Build outputs
dist/
dist-ssr/
build/
.cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# Generated test PDFs — should not be committed
test_pass_*.pdf
test_*.pdf

# Coverage
coverage/

.vercel
.env*
